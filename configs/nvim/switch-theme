#! /bin/sh
# Switch nvim colorscheme: persists it for new instances and pushes it live
# into every running nvim over its RPC socket (no external deps).
set -e

cwd=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case "$1" in
  light) scheme="trash-polka-light" ;;
  dark)  scheme="trash-polka" ;;
  *) echo "there is no \"$1\" command"; exit 1 ;;
esac

echo "vim.cmd 'colorscheme ${scheme}'" > "${cwd}/lua/colorscheme.lua"

for instance in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*; do
  [ -S "$instance" ] || continue
  nvim --server "$instance" --remote-expr "execute('colorscheme ${scheme}')" >/dev/null 2>&1 || true
done
