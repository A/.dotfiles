{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "output": "!eDP-1",
  "include": ["~/.config/waybar/status.modules.jsonc"],
  "height": 36,
  "spacing": 8,
  // Horizontal margin matches Hyprland's gaps_out (90-theme.conf) so module
  // edges line up with window edges. Same value as bottom.config.
  "margin": "0 10px -10px",
  "modules-left": [
    "hyprland/workspaces",
    "custom/claude-tokens",
    "custom/timer",
    "custom/btcusd",
    "custom/ethusdt",
    "custom/usdrub",
    "custom/eurrub",
    "custom/audio-inbox",
    "custom/audio-collection"
  ],
  "modules-center": [],
  "modules-right": [
    "group/status",
    "custom/beets",
    "custom/pipewire",
    "custom/g9-mode",
    "clock"
  ],
  // The shared status modules (status.modules.jsonc) in one card, like the
  // other modules on this bar; on the laptop bar they stay bare.
  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "custom/hyprshade",
      "custom/inhibitor",
      "custom/pacman",
      "custom/docker",
      "custom/github",
      "custom/notification"
    ]
  },
  "clock": {
    "tooltip-format": "<tt>{calendar}</tt>",
    "format-alt": "{:%Y-%m-%d}"
  },
  "custom/g9-mode": {
    "tooltip": false,
    "format": "󰍹  {}",
    "interval": 10,
    "signal": 4,
    "exec": "hyprctl monitors -j | jq -r '[.[] | select(.model==\"Odyssey G95NC\") | \"\\(.width)x\\(.height)@\\(.refreshRate|round)\"] | join(\" + \")'",
    "exec-if": "hyprctl monitors -j | jq -e '[.[] | select(.model==\"Odyssey G95NC\")] | length > 0' >/dev/null"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "active": "",
      "default": "",
      "persistent": ""
    },
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "all-outputs": true,
    "show-special": false,
    "ignore-workspaces": ["special", "desktop-.*"],
  },

  "custom/timer": {
    "exec": "uairctl fetch '<b>{name}</b>:{time}'",
    "tooltip": false,
    "format": "  {}",
    "on-click": "uairctl toggle",
    "on-scroll-up": "uairctl next",
    "on-scroll-down": "uairctl prev",
    "interval": 1,
  },

  "custom/beets": {
    "exec": "musictl waybar --max-length 50",
    "return-type": "json",
    "format": "{}",
    "tooltip": true
  },

  "custom/pipewire": {
    "exec": "wpctl inspect @DEFAULT_AUDIO_SINK@ | awk '/alsa.card_name|media.name|node.description/ { print }' | cut -d '\"' -f2",
    "tooltip": false,
    "format": "󰓃 {}",
    "interval": 5,
  },

  "custom/btcusd": {
    "tooltip": false,
    "format": " {}",
    "exec": "grep 'BTCUSD:' ~/.cache/currencies | awk '{print $2}'",
    "interval": 60,
  },

  "custom/ethusdt": {
    "tooltip": false,
    "format": " {}",
    "exec": "grep 'ETHUSDT:' ~/.cache/currencies | awk '{print $2}'",
    "interval": 60,
  },

  "custom/usdrub": {
    "tooltip": false,
    "format": " {}",
    "exec": "grep 'USDRUB:' ~/.cache/currencies | awk '{print $2}'",
    "interval": 60,
  },

  "custom/eurrub": {
    "tooltip": false,
    "format": " {}",
    "exec": "grep 'EURRUB:' ~/.cache/currencies | awk '{print $2}'",
    "interval": 60,
  },

  "custom/audio-inbox": {
    "format": "INB:{}",
    "tooltip": false,
    "exec": "playlist-length inbox",
    "interval": 60,
    "on-click": "thunar ~/Dropbox/inbox/"
  },

  "custom/audio-collection": {
    "format": "COL:{}",
    "tooltip": false,
    "exec": "playlist-length collection",
    "interval": 300,
    "on-click": "thunar ~/Dropbox/collection/"
  },

  // Cache is refreshed hourly by the `claude-usage` user timer (private companion repo).
  "custom/claude-tokens": {
    "format": "󰚩  {}",
    "return-type": "json",
    "exec": "cat ~/.tmp/.claude_tokens 2>/dev/null",
    "exec-if": "test -s ~/.tmp/.claude_tokens",
    "interval": 300,
    "on-click": "claude-usage"
  }
}
