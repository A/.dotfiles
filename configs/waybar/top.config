{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "output": "eDP-1",
  "include": ["~/.config/waybar/status.modules.jsonc"],
  "height": 36,
  "spacing": 8,
  "margin": "0 6px -10px",
  "modules-left": [
    "custom/wlogout",
    "custom/gamescope",
    "hyprland/workspaces",
    "group/zapusk",
    "hyprland/submap",
  ],
  "modules-center": [
    "custom/hyprshade",
    "custom/inhibitor",
    "custom/pacman",
    "custom/docker",
    "custom/github",
    "custom/notification"
  ],
  // Pomodoro timer, default sink and the current track moved to
  // external.config (the G9 bar).
  "modules-right": [
    "tray",
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "active": "",
      "default": "",
      "persistent": ""
    },
    "on-scroll-up": "hyprctl dispatch workspace r-1",
    "on-scroll-down": "hyprctl dispatch workspace r+1",
    "all-outputs": true,
    "show-special": false,
    "ignore-workspaces": ["special"],
  },
  "hyprland/submap": {
    "format": "  {}",
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/dela": {
    "format": "  {}",
    "exec": "dela list --today --format='$title' '/home/anton/Dev/@A/notes/*.md' | wc -l",
    "on-click": "dela_create_cache && dela_open",
    "interval": 300,
  },

  "custom/newsboat": {
    "format": "󰑬  {}",
    "exec-if": "whereis newsboat",
    "exec": "~/.config/waybar/bin/newsboat-stats.sh",
    "on-click": "kitty --class float --hold zsh -c 'sleep 1; newsboat'",
    "interval": 180
  },

  // paru -S waybar-module-pacman-updates-git
  // TODO: just use checkupdates ?
  "custom/timer-stats": {
    "exec": "~/.config/waybar/bin/uair-stats.sh",
    "tooltip": false,
    "format": "{}",
    "interval": 60,
  },

  "custom/wlogout": {
      "format": "⏻",
      "on-click": "wlogout",
      "tooltip": false
  },

  "custom/gamescope": {
      "exec": "echo 󰊴",
      "exec-if": "which steamos-session-select",
      "format": "{}",
      "on-click": "steamos-session-select gamescope && hyprctl dispatch exit",
      "tooltip": false,
      "interval": "once"
  },
  "group/zapusk": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/zapusk-handle",
      "custom/zapusk"
    ]
  },
  "custom/zapusk-handle": {
    "format": "󰅐",
    "tooltip-format": "Zapusk tasks",
    "on-click": "zapusk config_jobs --no-colors | jq -r \".[].id\" | wofi --dmenu | xargs -I{} zapusk run {}"
  },
  "custom/zapusk": {
    "exec": "zapusk waybar",
    "tooltip": true,
    "return-type": "json",
    "format": "{}",
    "interval": 5,
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },
  "pulseaudio": {
    // show a mic icon + volume percentage
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",          // red crossed ‑out mic
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "tooltip-format": "{desc} – {volume}%"
  }
}

