#!/usr/bin/env bash

# ACPI platform profile sets the real power limit (STAPM); EPP only biases the governor
PLATFORM=/sys/firmware/acpi/platform_profile
EPP_OPTIONS="power balance_power balance_performance performance"

CUR_PLATFORM=$(cat "$PLATFORM")
CUR_EPP=$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference)

CHOICE=$(
  {
    read -ra PLATFORM_OPTIONS < "${PLATFORM}_choices"
    for p in "${PLATFORM_OPTIONS[@]}"; do echo "platform: $p"; done
    for e in $EPP_OPTIONS; do echo "epp: $e"; done
  } | wofi --dmenu --prompt "platform: $CUR_PLATFORM | epp: $CUR_EPP" --lines 8 "$@"
)

case "$CHOICE" in
  "platform: "*)
    VALUE=${CHOICE#platform: }
    # Root-owned; needs sudoers NOPASSWD for /usr/bin/tee /sys/firmware/acpi/platform_profile
    if ! echo "$VALUE" | sudo -n tee "$PLATFORM" > /dev/null; then
      notify-send -u critical "Power Mode" "sudoers rule for tee $PLATFORM is missing"
      exit 1
    fi
    notify-send "Power Mode" "Platform profile: $VALUE"
    ;;
  "epp: "*)
    VALUE=${CHOICE#epp: }
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
      echo "$VALUE" | tee "$cpu" > /dev/null
    done
    notify-send "Power Mode" "EPP: $VALUE"
    ;;
esac
