#!/bin/bash
# Convert PDF to Markdown via marker API

if [[ -z "$MARKER_API_URL" ]]; then
    env_file="${XDG_CONFIG_HOME:-$HOME/.config}/pdf2md/pdf2md.env"
    # shellcheck disable=SC1090
    [[ -f "$env_file" ]] && { set -a; . "$env_file"; set +a; }
fi
if [[ -z "$MARKER_API_URL" ]]; then
    echo "Error: MARKER_API_URL is not set (base URL of a marker API server, e.g. http://host:8000)" >&2
    exit 1
fi
MARKER_API="$MARKER_API_URL"

if [[ -z "$1" ]]; then
    echo "Usage: pdf2md <file.pdf> [output.md]"
    exit 1
fi

pdf_file="$1"
if [[ ! -f "$pdf_file" ]]; then
    echo "Error: File not found: $pdf_file"
    exit 1
fi

# Output file: use provided name or derive from input
if [[ -n "$2" ]]; then
    output="$2"
else
    output="${pdf_file%.pdf}.md"
fi

echo "Converting: $pdf_file -> $output"
curl -s -X POST "${MARKER_API}/convert" \
    -F "pdf_file=@${pdf_file}" \
    | jq -r '.[0].markdown' > "$output"

if [[ -s "$output" ]]; then
    echo "Done: $output"
else
    echo "Error: Conversion failed"
    rm -f "$output"
    exit 1
fi
